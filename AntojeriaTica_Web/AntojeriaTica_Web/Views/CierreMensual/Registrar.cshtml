@model AntojeriaTica_Web.Models.CierreFinancieroMensual

@{
    ViewData["Title"] = "Generar Cierre Mensual";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-container {
        max-width: 450px;
        margin: 100px auto 0 auto; 
        padding: 25px;
        background-color: #2c2f33;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0,0,0,0.5);
        color: white;
        font-family: Arial, sans-serif;
    }

        .form-container label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
        }

        .form-container input[type=number],
        .form-container input[type=text],
        .form-container textarea {
            width: 100%;
            padding: 10px;
            margin-bottom: 18px;
            border-radius: 5px;
            border: none;
            background-color: #40444b;
            color: #fff;
            font-size: 14px;
            box-sizing: border-box;
            font-family: inherit;
        }

        .form-container input[readonly] {
            background-color: #33363b;
            cursor: not-allowed;
        }

        .form-container button {
            width: 100%;
            padding: 12px;
            background-color: #1abc9c;
            border: none;
            border-radius: 5px;
            font-weight: bold;
            color: white;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            font-family: inherit;
        }

            .form-container button:hover {
                background-color: #16a085;
            }

    .error-message {
        color: #ff6b6b;
        margin-bottom: 15px;
        font-weight: 600;
        text-align: center;
    }
</style>

<div class="form-container">
    <h2>@ViewData["Title"]</h2>

    @if (ViewBag.Error != null)
    {
        <div class="error-message">@ViewBag.Error</div>
    }

    <form asp-action="Registrar" method="post">
        <label>Mes</label>
        <input asp-for="Mes" type="number" min="1" max="12" required />

        <label>Año</label>
        <input asp-for="Anio" type="number" min="2000" max="2100" required />

        <label>Generado Por</label>
        <input asp-for="GeneradoPor" type="text" readonly />

        <label>Comentario (opcional)</label>
        <textarea asp-for="ComentarioJustificativo" rows="3"></textarea>

        <button type="submit">Generar cierre mensual</button>
    </form>
</div>
