@model AntojeriaTica_Web.Models.BusquedaFacturasElectronicasViewModel
@{
    ViewData["Title"] = "Facturación Electrónica";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="fas fa-file-invoice-dollar text-primary"></i> Facturación Electrónica</h2>
            <p class="text-muted">Administra las facturas electrónicas generadas</p>
        </div>
    </div>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search Card -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-search"></i> Buscar Facturas Electrónicas</h5>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("BuscarFacturas", "FacturacionElectronica", FormMethod.Post, new { @class = "row g-3" }))
            {
                <div class="col-md-3">
                    @Html.LabelFor(m => m.FechaInicio, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.FechaInicio, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                </div>

                <div class="col-md-3">
                    @Html.LabelFor(m => m.FechaFin, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.FechaFin, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date" })
                </div>

                <div class="col-md-3">
                    @Html.LabelFor(m => m.NumeroFactura, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.NumeroFactura, new { @class = "form-control", @placeholder = "Número de factura" })
                </div>

                <div class="col-md-3">
                    @Html.LabelFor(m => m.ClienteNombre, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.ClienteNombre, new { @class = "form-control", @placeholder = "Nombre del cliente" })
                </div>

                <div class="col-md-3">
                    @Html.LabelFor(m => m.EstadoHacienda, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.EstadoHacienda, new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Todos", Value = "" },
                        new SelectListItem { Text = "Pendiente", Value = "Pendiente" },
                        new SelectListItem { Text = "Aceptado", Value = "Aceptado" },
                        new SelectListItem { Text = "Rechazado", Value = "Rechazado" },
                        new SelectListItem { Text = "Error", Value = "Error" }
                    }, new { @class = "form-select" })
                </div>

                <div class="col-md-9 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-search"></i> Buscar
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="limpiarFiltros()">
                        <i class="fas fa-eraser"></i> Limpiar
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Results Card -->
    <div class="card">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="fas fa-list"></i> Resultados de Búsqueda (@Model.Facturas.Count facturas encontradas)</h5>
        </div>
        <div class="card-body">
            @if (Model.Facturas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Número</th>
                                <th>Cliente</th>
                                <th>Fecha</th>
                                <th>Total</th>
                                <th>Estado Hacienda</th>
                                <th>Email</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var factura in Model.Facturas)
                            {
                                <tr>
                                    <td>
                                        <strong>@factura.NumeroFactura</strong><br>
                                        <small class="text-muted">@factura.ClaveNumerica</small>
                                    </td>
                                    <td>
                                        <strong>@factura.ClienteNombre</strong>
                                        @if (!string.IsNullOrEmpty(factura.ClienteEmail))
                                        {
                                            <br><small class="text-muted">@factura.ClienteEmail</small>
                                        }
                                    </td>
                                    <td>@factura.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <strong class="text-success">₡@factura.MontoTotal.ToString("N2")</strong>
                                    </td>
                                    <td>
                                        @if (factura.EstadoHacienda == "Aceptado")
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check"></i> @factura.EstadoHacienda</span>
                                        }
                                        else if (factura.EstadoHacienda == "Rechazado")
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-times"></i> @factura.EstadoHacienda</span>
                                        }
                                        else if (factura.EstadoHacienda == "Error")
                                        {
                                            <span class="badge bg-warning"><i class="fas fa-exclamation-triangle"></i> @factura.EstadoHacienda</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="fas fa-clock"></i> @factura.EstadoHacienda</span>
                                        }
                                    </td>
                                    <td>
                                        @if (factura.EmailEnviado)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-envelope"></i> Enviado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="fas fa-envelope"></i> Pendiente</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Detalle", new { id = factura.IdFactura })" 
                                               class="btn btn-sm btn-primary" title="Ver detalle">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("DescargarPDF", new { id = factura.IdFactura })" 
                                               class="btn btn-sm btn-success" title="Descargar PDF">
                                                <i class="fas fa-file-pdf"></i>
                                            </a>
                                            @if (!string.IsNullOrEmpty(factura.ClienteEmail))
                                            {
                                                <button type="button" class="btn btn-sm btn-warning" 
                                                        onclick="reenviarEmail(@factura.IdFactura, '@factura.ClienteEmail')"
                                                        title="Reenviar por email">
                                                    <i class="fas fa-paper-plane"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-search fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No se encontraron facturas electrónicas</h5>
                    <p class="text-muted">Prueba ajustando los filtros de búsqueda</p>
                </div>
            }
        </div>
    </div>
</div>

<script>
function limpiarFiltros() {
    document.getElementById('FechaInicio').value = '';
    document.getElementById('FechaFin').value = '';
    document.getElementById('NumeroFactura').value = '';
    document.getElementById('ClienteNombre').value = '';
    document.getElementById('EstadoHacienda').value = '';
}

function reenviarEmail(idFactura, email) {
    if (confirm('¿Está seguro que desea reenviar la factura por email a ' + email + '?')) {
        fetch('@Url.Action("ReenviarEmail", "FacturacionElectronica")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({
                idFactura: idFactura,
                email: email
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Email reenviado exitosamente');
                location.reload();
            } else {
                alert('Error al reenviar email: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error inesperado al reenviar email');
        });
    }
}
</script>
