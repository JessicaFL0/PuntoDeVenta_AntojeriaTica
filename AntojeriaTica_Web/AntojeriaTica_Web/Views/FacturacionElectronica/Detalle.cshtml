@model AntojeriaTica_Web.Models.DetalleFacturaElectronicaModel
@{
    ViewData["Title"] = "Detalle de Factura Electrónica";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "FacturacionElectronica")">Facturación Electrónica</a></li>
                    <li class="breadcrumb-item active">Detalle Factura</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2><i class="fas fa-file-invoice text-primary"></i> Detalle de Factura Electrónica</h2>
                    <p class="text-muted">@Model.NumeroFactura</p>
                </div>
                <div>
                    <div class="btn-group" role="group">
                        <a href="@Url.Action("DescargarPDF", new { id = Model.IdFactura })" 
                           class="btn btn-success">
                            <i class="fas fa-file-pdf"></i> Descargar PDF
                        </a>
                        @if (!string.IsNullOrEmpty(Model.ClienteEmail))
                        {
                            <button type="button" class="btn btn-warning" 
                                    onclick="reenviarEmail(@Model.IdFactura, '@Model.ClienteEmail')">
                                <i class="fas fa-paper-plane"></i> Reenviar Email
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Información General -->
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Información General</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Número de Factura:</strong></td>
                                    <td>@Model.NumeroFactura</td>
                                </tr>
                                <tr>
                                    <td><strong>Clave Numérica:</strong></td>
                                    <td><small>@Model.ClaveNumerica</small></td>
                                </tr>
                                <tr>
                                    <td><strong>Fecha de Emisión:</strong></td>
                                    <td>@Model.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                                <tr>
                                    <td><strong>Venta Asociada:</strong></td>
                                    <td>#@Model.VentaId (@Model.FechaVenta.ToString("dd/MM/yyyy"))</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Cliente:</strong></td>
                                    <td>@Model.ClienteNombre</td>
                                </tr>
                                <tr>
                                    <td><strong>Identificación:</strong></td>
                                    <td>@(Model.ClienteIdentificacion ?? "No proporcionada")</td>
                                </tr>
                                <tr>
                                    <td><strong>Email:</strong></td>
                                    <td>@(Model.ClienteEmail ?? "No proporcionado")</td>
                                </tr>
                                <tr>
                                    <td><strong>Teléfono:</strong></td>
                                    <td>@(Model.ClienteTelefono ?? "No proporcionado")</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detalle de Productos -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-list"></i> Detalle de Productos</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Precio Unit.</th>
                                    <th>Subtotal</th>
                                    <th>% Imp.</th>
                                    <th>Impuesto</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var producto in Model.Productos)
                                {
                                    <tr>
                                        <td>
                                            <strong>@producto.Nombre</strong>
                                            @if (!string.IsNullOrEmpty(producto.Codigo))
                                            {
                                                <br><small class="text-muted">Código: @producto.Codigo</small>
                                            }
                                            @if (!string.IsNullOrEmpty(producto.Descripcion))
                                            {
                                                <br><small class="text-muted">@producto.Descripcion</small>
                                            }
                                        </td>
                                        <td>@producto.Cantidad</td>
                                        <td>₡@producto.PrecioUnitario.ToString("N2")</td>
                                        <td>₡@producto.SubTotal.ToString("N2")</td>
                                        <td>@producto.PorcentajeImpuesto.ToString("N2")%</td>
                                        <td>₡@producto.MontoImpuesto.ToString("N2")</td>
                                        <td><strong>₡@((producto.SubTotal + producto.MontoImpuesto).ToString("N2"))</strong></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-secondary">
                                <tr>
                                    <th colspan="3">TOTALES</th>
                                    <th>₡@Model.SubTotal.ToString("N2")</th>
                                    <th></th>
                                    <th>₡@Model.MontoImpuesto.ToString("N2")</th>
                                    <th><strong>₡@Model.MontoTotal.ToString("N2")</strong></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Panel Lateral -->
        <div class="col-md-4">
            <!-- Estado de la Factura -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-check-circle"></i> Estado de la Factura</h5>
                </div>
                <div class="card-body text-center">
                    <div class="mb-3">
                        @if (Model.EstadoHacienda == "Aceptado")
                        {
                            <div class="badge bg-success fs-6 p-3">
                                <i class="fas fa-check-circle fa-2x d-block mb-2"></i>
                                ACEPTADA
                            </div>
                        }
                        else if (Model.EstadoHacienda == "Rechazado")
                        {
                            <div class="badge bg-danger fs-6 p-3">
                                <i class="fas fa-times-circle fa-2x d-block mb-2"></i>
                                RECHAZADA
                            </div>
                        }
                        else if (Model.EstadoHacienda == "Error")
                        {
                            <div class="badge bg-warning fs-6 p-3">
                                <i class="fas fa-exclamation-triangle fa-2x d-block mb-2"></i>
                                ERROR
                            </div>
                        }
                        else
                        {
                            <div class="badge bg-secondary fs-6 p-3">
                                <i class="fas fa-clock fa-2x d-block mb-2"></i>
                                PENDIENTE
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.MensajeHacienda))
                    {
                        <div class="alert alert-info">
                            <small><strong>Mensaje de Hacienda:</strong><br>@Model.MensajeHacienda</small>
                        </div>
                    }

                    <div class="row text-start">
                        <div class="col-12">
                            <small class="text-muted">
                                <i class="fas fa-envelope @(Model.EmailEnviado ? "text-success" : "text-secondary")"></i>
                                Email: @(Model.EmailEnviado ? "Enviado" : "No enviado")
                                @if (Model.FechaEnvioEmail.HasValue)
                                {
                                    <br>@Model.FechaEnvioEmail.Value.ToString("dd/MM/yyyy HH:mm")
                                }
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Resumen de Montos -->
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="fas fa-calculator"></i> Resumen de Montos</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <td>Subtotal:</td>
                            <td class="text-end"><strong>₡@Model.SubTotal.ToString("N2")</strong></td>
                        </tr>
                        <tr>
                            <td>Impuestos:</td>
                            <td class="text-end"><strong>₡@Model.MontoImpuesto.ToString("N2")</strong></td>
                        </tr>
                        <tr class="border-top">
                            <td><strong>TOTAL:</strong></td>
                            <td class="text-end"><h4 class="text-success">₡@Model.MontoTotal.ToString("N2")</h4></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Historial de Envíos -->
    @if (Model.HistorialEnvios.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="fas fa-history"></i> Historial de Envíos</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Tipo</th>
                                        <th>Destinatario</th>
                                        <th>Estado</th>
                                        <th>Mensaje</th>
                                        <th>Fecha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var envio in Model.HistorialEnvios)
                                    {
                                        <tr>
                                            <td>
                                                @if (envio.TipoEnvio == "Email")
                                                {
                                                    <span class="badge bg-info"><i class="fas fa-envelope"></i> @envio.TipoEnvio</span>
                                                }
                                                else if (envio.TipoEnvio == "Hacienda")
                                                {
                                                    <span class="badge bg-primary"><i class="fas fa-building"></i> @envio.TipoEnvio</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary"><i class="fas fa-redo"></i> @envio.TipoEnvio</span>
                                                }
                                            </td>
                                            <td>@(envio.Destinatario ?? "N/A")</td>
                                            <td>
                                                @if (envio.EstadoEnvio == "Enviado" || envio.EstadoEnvio == "Aceptado")
                                                {
                                                    <span class="badge bg-success">@envio.EstadoEnvio</span>
                                                }
                                                else if (envio.EstadoEnvio == "Error" || envio.EstadoEnvio == "Rechazado")
                                                {
                                                    <span class="badge bg-danger">@envio.EstadoEnvio</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@envio.EstadoEnvio</span>
                                                }
                                            </td>
                                            <td><small>@(envio.MensajeRespuesta ?? "N/A")</small></td>
                                            <td>@envio.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
function reenviarEmail(idFactura, email) {
    if (confirm('¿Está seguro que desea reenviar la factura por email a ' + email + '?')) {
        fetch('@Url.Action("ReenviarEmail", "FacturacionElectronica")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({
                idFactura: idFactura,
                email: email
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Email reenviado exitosamente');
                location.reload();
            } else {
                alert('Error al reenviar email: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error inesperado al reenviar email');
        });
    }
}
</script>
