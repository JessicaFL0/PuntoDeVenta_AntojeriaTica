@model AntojeriaTica_Web.Models.MovimientoDiario
@{
    ViewData["Title"] = "Registrar Movimiento";
    var categorias = ViewBag.Categorias as List<string> ?? new();
}

<h2 class="mt-3">Registrar Movimiento</h2>

<form asp-action="Registrar" method="post" class="mt-4">
    <div class="form-group">
        <label>Tipo de Movimiento</label>
        <select asp-for="TipoMovimiento" class="form-control">
            <option value="Ingreso">Ingreso</option>
            <option value="Egreso">Egreso</option>
        </select>
        <span asp-validation-for="TipoMovimiento" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Categoría</label>
        <select asp-for="Categoria" class="form-control">
            @foreach (var cat in categorias)
            {
                <option value="@cat">@cat</option>
            }
        </select>
        <span asp-validation-for="Categoria" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Monto</label>
        <input asp-for="Monto" class="form-control" />
        <span asp-validation-for="Monto" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Descripción</label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-3">@ViewBag.Error</div>
    }

    <button type="submit" class="btn btn-primary mt-3">Registrar</button>
    <a asp-action="Listar" class="btn btn-secondary mt-3">Cancelar</a>
</form>
