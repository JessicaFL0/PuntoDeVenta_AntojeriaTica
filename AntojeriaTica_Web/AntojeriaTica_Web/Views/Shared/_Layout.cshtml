@using Microsoft.AspNetCore.Http
@{
    var nombre = Context.Session.GetString("NombreCompleto");
    var rol = Context.Session.GetString("NombreRol");
    var isLogged = !string.IsNullOrEmpty(rol);
    var roleNorm = (rol ?? string.Empty).ToLowerInvariant();
    var isAdmin = roleNorm.Contains("admin");
    var isVendedor = roleNorm.Contains("vendedor");
    var isCajero = roleNorm.Contains("cajero");

    var pageTitle = ViewData["Title"] as string ?? "Antojería Tica";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle - Antojería Tica</title>
    <meta name="theme-color" content="#ce1212" />

    <link href="@Url.Content("~/Content/img/favicon.png")" rel="icon">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link href="@Url.Content("~/Content/vendor/bootstrap/css/bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/vendor/bootstrap-icons/bootstrap-icons.css")" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <link href="@Url.Content("~/css/site.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/theme.css")" rel="stylesheet" />
</head>
<body>
    <div class="app-shell">
        <!-- Sidebar -->
        <aside id="app-sidebar" class="app-sidebar">
            <div class="brand">
                <div class="image">
                    <img src="https://olaclick-assets-prod.s3.amazonaws.com/companies/logos/108a39f5-4103-4a80-b1aa-95a10c41809c.webp" alt="Antojería Tica" />
                </div>
                <div class="title">Antojería Tica</div>
            </div>

            @if (isLogged)
            {
                if (isAdmin)
                {
                    <div class="nav-section">
                        <div class="caption">Operaciones</div>
                        <ul class="sidebar-nav">
                            <li><a href="@Url.Action("RegistrarVenta","Ventas")"><i class="bi bi-cash"></i> Nueva Venta</a></li>
                            <li><a href="@Url.Action("BuscarVentas","Ventas")"><i class="bi bi-search"></i> Buscar Ventas</a></li>
                            <li><a href="@Url.Action("ProcesarDevoluciones","Ventas")"><i class="bi bi-arrow-counterclockwise"></i> Devoluciones</a></li>
                            <li><a href="@Url.Action("Index","Pedidos")"><i class="bi bi-receipt"></i> Pedidos</a></li>
                        </ul>
                    </div>
                    <div class="nav-section">
                        <div class="caption">Inventario</div>
                        <ul class="sidebar-nav">
                            <li><a href="@Url.Action("ListarProductos","Inventario")"><i class="bi bi-box-seam"></i> Productos</a></li>
                            <li><a href="@Url.Action("EstadoInventario","Inventario")"><i class="bi bi-graph-up"></i> Estado</a></li>
                        </ul>
                    </div>
                    <div class="nav-section">
                        <div class="caption">Finanzas</div>
                        <ul class="sidebar-nav">
                            <li><a href="@Url.Action("Listar","MovimientoDiario")"><i class="bi bi-arrows-left-right"></i> Movimientos</a></li>
                            <li><a href="@Url.Action("Index","CierreCaja")"><i class="bi bi-calculator"></i> Cierre de Caja</a></li>
                            <li><a href="@Url.Action("ReporteVentasDia","Ventas")"><i class="bi bi-bar-chart"></i> Reporte ventas del día</a></li>
                            <li><a href="@Url.Action("VentasAnuales","Reporte")"><i class="bi bi-graph-up"></i> Ventas por año</a></li>
                            <li><a href="@Url.Action("Dashboard","Reporte")"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li><a href="@Url.Action("GenerarReporte","Reporte")"><i class="bi bi-file-earmark-text"></i> Generar reporte</a></li>
                        </ul>
                    </div>
                    <div class="nav-section">
                        <div class="caption">Administración</div>
                        <ul class="sidebar-nav">
                            <li><a href="@Url.Action("ListarUsuarios","Login")"><i class="bi bi-people"></i> Usuarios</a></li>
                            <li><a href="@Url.Action("ListarRoles","Login")"><i class="bi bi-shield-check"></i> Roles</a></li>
                            <li><a href="@Url.Action("ConfiguracionImpuestos","Impuestos")"><i class="bi bi-percent"></i> Impuestos</a></li>
                            <li><a href="@Url.Action("GestionarDescuentos","Ventas")"><i class="bi bi-tags"></i> Descuentos</a></li>
                            <li><a href="@Url.Action("ConfiguracionPago","Ventas")"><i class="bi bi-credit-card"></i> Métodos de Pago</a></li>
                            <li><a href="@Url.Action("Index","FacturacionElectronica")"><i class="bi bi-filetype-xml"></i> Facturación</a></li>
                        </ul>
                    </div>
                }
                else if (isCajero)
                {
                    <div class="nav-section">
                        <div class="caption">Operaciones</div>
                        <ul class="sidebar-nav">
                            <li><a href="@Url.Action("RegistrarVenta","Ventas")"><i class="bi bi-cash"></i> Nueva Venta</a></li>
                            <li><a href="@Url.Action("BuscarVentas","Ventas")"><i class="bi bi-search"></i> Buscar Ventas</a></li>
                            <li><a href="@Url.Action("ProcesarDevoluciones","Ventas")"><i class="bi bi-arrow-counterclockwise"></i> Devoluciones</a></li>
                            <li><a href="@Url.Action("Index","Pedidos")"><i class="bi bi-receipt"></i> Pedidos</a></li>
                        </ul>
                    </div>
                    <div class="nav-section">
                        <div class="caption">Finanzas</div>
                        <ul class="sidebar-nav">
                            <li><a href="@Url.Action("Listar","MovimientoDiario")"><i class="bi bi-arrows-left-right"></i> Movimientos</a></li>
                            <li><a href="@Url.Action("Index","CierreCaja")"><i class="bi bi-calculator"></i> Cierre de Caja</a></li>
                            <li><a href="@Url.Action("ReporteVentasDia","Ventas")"><i class="bi bi-bar-chart"></i> Reporte ventas del día</a></li>
                            <li><a href="@Url.Action("VentasAnuales","Reporte")"><i class="bi bi-graph-up"></i> Ventas por año</a></li>
                        </ul>
                    </div>
                }
                else if (isVendedor)
                {
                    <div class="nav-section">
                        <div class="caption">Operaciones</div>
                        <ul class="sidebar-nav">
                            <li><a href="@Url.Action("RegistrarVenta","Ventas")"><i class="bi bi-cash"></i> Nueva Venta</a></li>
                            <li><a href="@Url.Action("BuscarVentas","Ventas")"><i class="bi bi-search"></i> Buscar Ventas</a></li>
                            <li><a href="@Url.Action("ProcesarDevoluciones","Ventas")"><i class="bi bi-arrow-counterclockwise"></i> Devoluciones</a></li>
                            <li><a href="@Url.Action("Index","Pedidos")"><i class="bi bi-receipt"></i> Pedidos</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="nav-section">
                        <div class="caption">Pedidos</div>
                        <ul class="sidebar-nav">
                            <li><a href="@Url.Action("Index","Pedidos")"><i class="bi bi-receipt"></i> Pedidos</a></li>
                        </ul>
                    </div>
                }
            }
            else
            {
                <div class="nav-section">
                    <div class="caption">Bienvenido</div>
                    <ul class="sidebar-nav">
                        <li><a href="@Url.Action("IniciarSesion","Login")"><i class="bi bi-box-arrow-in-right"></i> Iniciar sesión</a></li>
                        <li><a href="@Url.Action("RegistrarCuenta","Login")"><i class="bi bi-person-plus"></i> Crear cuenta</a></li>
                        <li><a href="@Url.Action("RecuperarContrasena","Login")"><i class="bi bi-key"></i> Recuperar contraseña</a></li>
                    </ul>
                </div>
            }
        </aside>

        <!-- Main -->
        <div class="app-main">
            <header class="app-header">
                <div class="header-bar">
                    <button id="btn-toggle" class="btn btn-sm btn-toggle"><i class="bi bi-layout-sidebar"></i></button>
                    <div class="search input-group">
                        <span class="input-group-text border-soft bg-surface-2"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Buscar..." />
                    </div>
                    <button id="btn-theme" class="btn btn-sm btn-theme" title="Tema">
                        <i class="bi bi-moon"></i>
                    </button>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        @if (isLogged)
                        {
                            <span class="badge badge-role">@rol</span>
                            <span class="text-muted small"><i class="bi bi-person-circle me-1"></i>@(nombre ?? "Usuario")</span>
                            <a class="btn btn-sm btn-outline-danger ms-2" href="@Url.Action("CerrarSesion","Login")"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-brand" href="@Url.Action("IniciarSesion","Login")"><i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión</a>
                        }
                    </div>
                </div>
            </header>

            <main class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <div class="footer-inner">
                    <div>© @DateTime.Now.Year Antojería Tica</div>
                    <div class="text-muted">Punto de Venta · Rendimiento y usabilidad</div>
                </div>
            </footer>
        </div>
    </div>

    <script src="@Url.Content("~/Content/vendor/bootstrap/js/bootstrap.bundle.min.js")"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="@Url.Content("~/js/theme.js")"></script>

    <script>
        // Mensajes globales (TempData/ViewBag)
        (function(){
            const ok = '@(TempData["Mensaje"] ?? "")';
            const err = '@(ViewBag.Error ?? TempData["Error"] ?? "")';
            if(ok){
                Swal.fire({icon:'success', title:'Listo', text: ok, confirmButtonColor:'#ce1212'});
            }
            if(err){
                Swal.fire({icon:'error', title:'Error', text: err, confirmButtonColor:'#ce1212'});
            }
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
