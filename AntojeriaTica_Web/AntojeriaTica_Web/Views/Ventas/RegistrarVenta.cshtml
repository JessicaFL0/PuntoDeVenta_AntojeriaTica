@model AntojeriaTica_Web.Models.VentaModel

@{
    ViewData["Title"] = "Registrar Venta";
}

<h2>Registrar Venta</h2>

<form asp-action="RegistrarVenta" method="post">
    <div class="form-group">
        <label>Método de Pago</label>
        <select asp-for="MetodoPago" class="form-control" required>
            <option value="">-- Seleccione --</option>
            <option value="Efectivo">Efectivo</option>
            <option value="Tarjeta">Tarjeta</option>
            <option value="Sinpe Móvil">Sinpe Móvil</option>
        </select>
    </div>

    <hr />

    <h4>Productos</h4>
    <div id="productos">
        <div class="producto row mb-2">
            <div class="col">
                <input type="number" name="Detalles[0].ProductoId" class="form-control" placeholder="ID Producto" required />
            </div>
            <div class="col">
                <input type="number" name="Detalles[0].Cantidad" class="form-control" placeholder="Cantidad" required />
            </div>
            <div class="col">
                <input type="number" step="0.01" name="Detalles[0].PrecioUnitario" class="form-control" placeholder="Precio Unitario" required />
            </div>
        </div>
    </div>

    <button type="button" class="btn btn-secondary mb-3" onclick="agregarProducto()">+ Agregar Producto</button>

    <div>
        <button type="submit" class="btn btn-primary">Registrar Venta</button>
    </div>
</form>

@section Scripts {
    <script>
        let contador = 1;

        function agregarProducto() {
            const container = document.getElementById("productos");

            const row = document.createElement("div");
            row.classList.add("producto", "row", "mb-2");

            row.innerHTML = `
                <div class="col">
                    <input type="number" name="Detalles[${contador}].ProductoId" class="form-control" placeholder="ID Producto" required />
                </div>
                <div class="col">
                    <input type="number" name="Detalles[${contador}].Cantidad" class="form-control" placeholder="Cantidad" required />
                </div>
                <div class="col">
                    <input type="number" step="0.01" name="Detalles[${contador}].PrecioUnitario" class="form-control" placeholder="Precio Unitario" required />
                </div>
            `;

            container.appendChild(row);
            contador++;
        }
    </script>
}

