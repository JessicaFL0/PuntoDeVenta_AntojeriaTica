@model AntojeriaTica_Web.Models.VentaModel

@{
    ViewData["Title"] = "Registrar Venta";
}

<h2>Registrar Venta</h2>

<form asp-action="RegistrarVenta" method="post">
    <div class="form-group">
        <label>Método de Pago</label>
        <select asp-for="MetodoPago" class="form-control" required>
            <option value="">-- Seleccione --</option>
            <option value="Efectivo">Efectivo</option>
            <option value="Tarjeta">Tarjeta</option>
            <option value="Sinpe Móvil">Sinpe Móvil</option>
        </select>
        <div class="form-group mt-3">
            <label for="CodigoCupon">Código de Cupón o Descuento</label>
            <input asp-for="CodigoCupon" class="form-control" placeholder="Ingrese el código si aplica" />
            <div class="input-group mt-2">
                <button type="button" class="btn btn-outline-primary" onclick="validarCupon()">Validar Cupón</button>
            </div>
            <small id="mensajeCupon" class="form-text text-muted"></small>
        </div>

    </div>

    <hr />

    <h4>Productos</h4>
    <div id="productos">
        <div class="producto row mb-2">
            <div class="col">
                <input type="number" name="Detalles[0].ProductoId" class="form-control" placeholder="ID Producto" required />
            </div>
            <div class="col">
                <input type="number" name="Detalles[0].Cantidad" class="form-control" placeholder="Cantidad" required />
            </div>
            <div class="col">
                <input type="number" step="0.01" name="Detalles[0].PrecioUnitario" class="form-control" placeholder="Precio Unitario" required />
            </div>
        </div>
    </div>

    <button type="button" class="btn btn-secondary mb-3" onclick="agregarProducto()">+ Agregar Producto</button>

    <div class="mb-3">
    <label>Total (₡)</label>
    <input type="text" id="totalVenta" class="form-control" readonly />
</div>

    <div>
        <button type="submit" class="btn btn-primary">Registrar Venta</button>
    </div>
</form>

@section Scripts {
    <script>
        let contador = 1;

        function agregarProducto() {
            const container = document.getElementById("productos");

            const row = document.createElement("div");
            row.classList.add("producto", "row", "mb-2");

            row.innerHTML = `
                <div class="col">
                    <input type="number" name="Detalles[${contador}].ProductoId" class="form-control" placeholder="ID Producto" required />
                </div>
                <div class="col">
                    <input type="number" name="Detalles[${contador}].Cantidad" class="form-control" placeholder="Cantidad" required />
                </div>
                <div class="col">
                    <input type="number" step="0.01" name="Detalles[${contador}].PrecioUnitario" class="form-control" placeholder="Precio Unitario" required />
                </div>
            `;

            container.appendChild(row);
            contador++;
        }
    </script>
    <script>
        async function validarCupon() {
            const codigo = document.getElementById("CodigoCupon").value.trim();
            const mensaje = document.getElementById("mensajeCupon");

            if (!codigo) {
                mensaje.innerText = "Por favor, ingrese un código.";
                mensaje.className = "form-text text-danger";
                return;
            }

            try {
                const response = await fetch(`http://localhost:5062/api/Descuento/ValidarCupon/${codigo}`);
                if (response.ok) {
                    const data = await response.json();
                    mensaje.innerText = `Cupón válido: ${data.Tipo === 'porcentaje' ? data.Valor + '% de descuento' : '₡' + data.Valor}`;
                    mensaje.className = "form-text text-success";
                } else {
                    mensaje.innerText = "Cupón inválido o expirado.";
                    mensaje.className = "form-text text-danger";
                }
            } catch (err) {
                mensaje.innerText = "Error al validar el cupón.";
                mensaje.className = "form-text text-danger";
            }
        }
    </script>

}

