@{
    ViewData["Title"] = "Buscar Venta para Devolución";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4><i class="fas fa-search me-2"></i>Buscar Venta para Devolución</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-receipt"></i></span>
                                <input type="number" id="ventaId" class="form-control" placeholder="Ingrese el ID de la venta" min="1">
                                <button class="btn btn-primary" type="button" onclick="buscarVenta()">
                                    <i class="fas fa-search me-1"></i>Buscar
                                </button>
                            </div>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                IDs de ventas disponibles para prueba: 9, 10, 11, 12, 13
                            </div>
                        </div>
                    </div>

                    <!-- Área de resultados -->
                    <div id="resultadoVenta" style="display: none;">
                        <div class="card border-success">
                            <div class="card-header bg-success text-white">
                                <h5><i class="fas fa-receipt me-2"></i>Información de la Venta</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <p><strong>ID de Venta:</strong> <span id="ventaIdInfo"></span></p>
                                        <p><strong>Fecha:</strong> <span id="ventaFecha"></span></p>
                                        <p><strong>Método de Pago:</strong> <span id="ventaMetodoPago"></span></p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Total:</strong> <span id="ventaTotal" class="fw-bold text-success"></span></p>
                                    </div>
                                </div>

                                <h6 class="mt-3 mb-3"><i class="fas fa-list me-2"></i>Productos</h6>
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Código</th>
                                                <th>Producto</th>
                                                <th>Cantidad</th>
                                                <th>Precio Unit.</th>
                                                <th>Subtotal</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tablaDetalles">
                                        </tbody>
                                    </table>
                                </div>

                                <div class="mt-3 d-flex gap-2">
                                    <button class="btn btn-warning" onclick="procesarDevolucionTotal()">
                                        <i class="fas fa-undo me-1"></i>Devolución Total
                                    </button>
                                    <button class="btn btn-info" onclick="procesarDevolucionParcial()">
                                        <i class="fas fa-undo-alt me-1"></i>Devolución Parcial
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Área de error -->
                    <div id="errorVenta" class="alert alert-danger" style="display: none;">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <span id="mensajeError"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modales de devolución -->
<!-- Modal Devolución Total -->
<div class="modal fade" id="modalDevolucionTotal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-undo me-2"></i>Devolución Total</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro de procesar la devolución total de esta venta?</p>
                <div class="mb-3">
                    <label for="motivoTotal" class="form-label">Motivo de la devolución:</label>
                    <select class="form-select" id="motivoTotal" required>
                        <option value="">Seleccione un motivo</option>
                        <option value="Producto defectuoso">Producto defectuoso</option>
                        <option value="No conforme">Cliente no conforme</option>
                        <option value="Error en pedido">Error en pedido</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>
                <div class="mb-3" id="otroMotivoTotalDiv" style="display: none;">
                    <label for="otroMotivoTotal" class="form-label">Especifique el motivo:</label>
                    <textarea class="form-control" id="otroMotivoTotal" rows="3"></textarea>
                </div>
                <p class="fw-bold">Monto a devolver: <span id="montoTotal" class="text-success"></span></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-warning" onclick="confirmarDevolucionTotal()">Procesar Devolución</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Devolución Parcial -->
<div class="modal fade" id="modalDevolucionParcial" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-undo-alt me-2"></i>Devolución Parcial</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Seleccione los productos a devolver:</p>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead class="table-dark">
                            <tr>
                                <th>Devolver</th>
                                <th>Producto</th>
                                <th>Cant. Original</th>
                                <th>Cant. a Devolver</th>
                                <th>Precio Unit.</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody id="tablaDevolucionParcial">
                        </tbody>
                    </table>
                </div>
                <div class="mb-3">
                    <label for="motivoParcial" class="form-label">Motivo de la devolución:</label>
                    <select class="form-select" id="motivoParcial" required>
                        <option value="">Seleccione un motivo</option>
                        <option value="Producto defectuoso">Producto defectuoso</option>
                        <option value="No conforme">Cliente no conforme</option>
                        <option value="Error en pedido">Error en pedido</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>
                <div class="mb-3" id="otroMotivoParcialDiv" style="display: none;">
                    <label for="otroMotivoParcial" class="form-label">Especifique el motivo:</label>
                    <textarea class="form-control" id="otroMotivoParcial" rows="3"></textarea>
                </div>
                <p class="fw-bold">Total a devolver: <span id="totalParcial" class="text-info">₡0.00</span></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-info" onclick="confirmarDevolucionParcial()">Procesar Devolución</button>
            </div>
        </div>
    </div>
</div>

<script>
let ventaActual = null;

function buscarVenta() {
    const ventaId = document.getElementById('ventaId').value;
    
    if (!ventaId || ventaId < 1) {
        mostrarError('Por favor ingrese un ID de venta válido');
        return;
    }

    // Ocultar resultados anteriores
    document.getElementById('resultadoVenta').style.display = 'none';
    document.getElementById('errorVenta').style.display = 'none';

    // Hacer petición AJAX
    fetch('/Ventas/BuscarVentaDevolucionAjax', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: `ventaId=${ventaId}`
    })
    .then(response => response.json())
    .then(data => {
        console.log('Datos recibidos:', data); // Para depuración
        
        if (data.error) {
            if (data.yaDevuelta && data.venta) {
                mostrarVentaYaDevuelta(data.venta);
            } else {
                mostrarError(data.error);
            }
        } else if (!data || data.id === 0 || !data.detalles || data.detalles.length === 0) {
            mostrarError('No se encontró la venta con ese ID. Pruebe con los IDs: 9, 10, 11, 12, 13');
        } else {
            mostrarVenta(data);
        }
    })
    .catch(error => {
        console.error('Error completo:', error); // Para depuración
        mostrarError('Error al conectar con el servidor: ' + error.message);
    });
}

function mostrarVenta(venta) {
    ventaActual = venta;
    
    // Llenar información básica con validaciones
    document.getElementById('ventaIdInfo').textContent = venta.id || 'N/A';
    document.getElementById('ventaFecha').textContent = venta.fecha ? new Date(venta.fecha).toLocaleDateString() : 'N/A';
    document.getElementById('ventaMetodoPago').textContent = venta.metodoPago || 'N/A';
    document.getElementById('ventaTotal').textContent = '₡' + (venta.total || 0).toLocaleString();

    // Llenar tabla de productos
    const tbody = document.getElementById('tablaDetalles');
    tbody.innerHTML = '';
    
    if (venta.detalles && venta.detalles.length > 0) {
        venta.detalles.forEach(detalle => {
            const row = tbody.insertRow();
            row.innerHTML = `
                <td>${detalle.productoCodigo || 'N/A'}</td>
                <td>${detalle.productoNombre || 'N/A'}</td>
                <td>${detalle.cantidad || 0}</td>
                <td>₡${(detalle.precioUnitario || 0).toLocaleString()}</td>
                <td>₡${(detalle.subtotal || 0).toLocaleString()}</td>
            `;
        });
    } else {
        const row = tbody.insertRow();
        row.innerHTML = '<td colspan="5" class="text-center">No se encontraron detalles</td>';
    }

    // Resetear estilo a normal (en caso de que se haya usado para venta ya devuelta)
    const card = document.querySelector('#resultadoVenta .card');
    card.className = 'card border-success';
    card.querySelector('.card-header').className = 'card-header bg-success text-white';
    card.querySelector('.card-header h5').innerHTML = '<i class="fas fa-receipt me-2"></i>Información de la Venta';
    
    // Mostrar botones de devolución
    const botones = card.querySelector('.mt-3.d-flex.gap-2') || card.querySelector('.mt-3');
    if (botones) {
        botones.innerHTML = `
            <button class="btn btn-warning" onclick="procesarDevolucionTotal()">
                <i class="fas fa-undo me-1"></i>Devolución Total
            </button>
            <button class="btn btn-info" onclick="procesarDevolucionParcial()">
                <i class="fas fa-undo-alt me-1"></i>Devolución Parcial
            </button>
        `;
        botones.className = 'mt-3 d-flex gap-2';
    }

    document.getElementById('resultadoVenta').style.display = 'block';
}

function mostrarVentaYaDevuelta(venta) {
    ventaActual = venta;
    
    // Llenar información básica con validaciones
    document.getElementById('ventaIdInfo').textContent = venta.id || 'N/A';
    document.getElementById('ventaFecha').textContent = venta.fecha ? new Date(venta.fecha).toLocaleDateString() : 'N/A';
    document.getElementById('ventaMetodoPago').textContent = venta.metodoPago || 'N/A';
    document.getElementById('ventaTotal').textContent = '₡' + (venta.total || 0).toLocaleString();

    // Llenar tabla de productos
    const tbody = document.getElementById('tablaDetalles');
    tbody.innerHTML = '';
    
    if (venta.detalles && venta.detalles.length > 0) {
        venta.detalles.forEach(detalle => {
            const row = tbody.insertRow();
            row.innerHTML = `
                <td>${detalle.productoCodigo || 'N/A'}</td>
                <td>${detalle.productoNombre || 'N/A'}</td>
                <td>${detalle.cantidad || 0}</td>
                <td>₡${(detalle.precioUnitario || 0).toLocaleString()}</td>
                <td>₡${(detalle.subtotal || 0).toLocaleString()}</td>
            `;
        });
    } else {
        const row = tbody.insertRow();
        row.innerHTML = '<td colspan="5" class="text-center">No se encontraron detalles</td>';
    }

    // Cambiar el estilo para indicar que ya está devuelta
    const card = document.querySelector('#resultadoVenta .card');
    card.className = 'card border-warning';
    card.querySelector('.card-header').className = 'card-header bg-warning text-dark';
    card.querySelector('.card-header h5').innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i>Venta Ya Devuelta';
    
    // Ocultar botones de devolución
    const botones = card.querySelector('.mt-3.d-flex.gap-2') || card.querySelector('.mt-3');
    if (botones) {
        botones.innerHTML = `
            <div class="alert alert-warning mb-0">
                <i class="fas fa-info-circle me-2"></i>
                Esta venta ya tiene devoluciones procesadas. No se pueden realizar más devoluciones.
            </div>
            <a href="/Ventas/HistorialDevoluciones" class="btn btn-info">
                <i class="fas fa-history me-1"></i>Ver Historial de Devoluciones
            </a>
        `;
        botones.className = 'mt-3';
    }

    document.getElementById('resultadoVenta').style.display = 'block';
}

function mostrarError(mensaje) {
    document.getElementById('mensajeError').textContent = mensaje;
    document.getElementById('errorVenta').style.display = 'block';
}

function procesarDevolucionTotal() {
    if (!ventaActual || !ventaActual.total) {
        mostrarError('No hay información de venta válida');
        return;
    }
    
    document.getElementById('montoTotal').textContent = '₡' + (ventaActual.total || 0).toLocaleString();
    new bootstrap.Modal(document.getElementById('modalDevolucionTotal')).show();
}

function procesarDevolucionParcial() {
    if (!ventaActual || !ventaActual.detalles || ventaActual.detalles.length === 0) {
        mostrarError('No hay productos válidos para devolver');
        return;
    }
    
    const tbody = document.getElementById('tablaDevolucionParcial');
    tbody.innerHTML = '';
    
    ventaActual.detalles.forEach((detalle, index) => {
        const row = tbody.insertRow();
        row.innerHTML = `
            <td>
                <input type="checkbox" class="form-check-input" id="check_${index}" onchange="calcularTotalParcial()">
            </td>
            <td>${detalle.productoNombre || 'N/A'}</td>
            <td>${detalle.cantidad || 0}</td>
            <td>
                <input type="number" class="form-control form-control-sm" id="cant_${index}" 
                       min="1" max="${detalle.cantidad || 1}" value="1" onchange="calcularTotalParcial()" disabled>
            </td>
            <td>₡${(detalle.precioUnitario || 0).toLocaleString()}</td>
            <td id="subtotal_${index}">₡0.00</td>
        `;
    });
    
    new bootstrap.Modal(document.getElementById('modalDevolucionParcial')).show();
}

function calcularTotalParcial() {
    if (!ventaActual || !ventaActual.detalles) return;
    
    let total = 0;
    
    ventaActual.detalles.forEach((detalle, index) => {
        const checkbox = document.getElementById(`check_${index}`);
        const cantInput = document.getElementById(`cant_${index}`);
        const subtotalSpan = document.getElementById(`subtotal_${index}`);
        
        if (!checkbox || !cantInput || !subtotalSpan) return;
        
        cantInput.disabled = !checkbox.checked;
        
        if (checkbox.checked) {
            const cantidad = parseInt(cantInput.value) || 0;
            const precioUnitario = detalle.precioUnitario || 0;
            const subtotal = cantidad * precioUnitario;
            subtotalSpan.textContent = '₡' + subtotal.toLocaleString();
            total += subtotal;
        } else {
            subtotalSpan.textContent = '₡0.00';
        }
    });
    
    const totalElement = document.getElementById('totalParcial');
    if (totalElement) {
        totalElement.textContent = '₡' + total.toLocaleString();
    }
}

function confirmarDevolucionTotal() {
    const motivo = document.getElementById('motivoTotal').value;
    if (!motivo) {
        alert('Debe seleccionar un motivo para la devolución');
        return;
    }
    
    let motivoFinal = motivo;
    if (motivo === 'Otro') {
        motivoFinal = document.getElementById('otroMotivoTotal').value;
        if (!motivoFinal.trim()) {
            alert('Debe especificar el motivo');
            return;
        }
    }
    
    // Procesar la devolución total
    const datosDevolucion = {
        VentaId: ventaActual.id,
        TipoDevolucion: 'Total',
        Motivo: motivoFinal,
        MontoDevolucion: ventaActual.total,
        DetallesDevolucion: ventaActual.detalles.map(detalle => ({
            ProductoId: detalle.productoId,
            CantidadDevuelta: detalle.cantidad,
            MontoDevuelto: detalle.subtotal
        }))
    };
    
    procesarDevolucion(datosDevolucion);
}

function confirmarDevolucionParcial() {
    const motivo = document.getElementById('motivoParcial').value;
    if (!motivo) {
        alert('Debe seleccionar un motivo para la devolución');
        return;
    }
    
    // Validar que al menos un producto esté seleccionado
    let haySeleccionados = false;
    let detallesDevolucion = [];
    let totalDevolucion = 0;
    
    ventaActual.detalles.forEach((detalle, index) => {
        const checkbox = document.getElementById(`check_${index}`);
        if (checkbox.checked) {
            haySeleccionados = true;
            const cantidadDevuelta = parseInt(document.getElementById(`cant_${index}`).value) || 0;
            if (cantidadDevuelta > 0) {
                const montoDevuelto = cantidadDevuelta * detalle.precioUnitario;
                detallesDevolucion.push({
                    ProductoId: detalle.productoId,
                    CantidadDevuelta: cantidadDevuelta,
                    MontoDevuelto: montoDevuelto
                });
                totalDevolucion += montoDevuelto;
            }
        }
    });
    
    if (!haySeleccionados || detallesDevolucion.length === 0) {
        alert('Debe seleccionar al menos un producto para devolver con cantidad mayor a 0');
        return;
    }
    
    let motivoFinal = motivo;
    if (motivo === 'Otro') {
        motivoFinal = document.getElementById('otroMotivoParcial').value;
        if (!motivoFinal.trim()) {
            alert('Debe especificar el motivo');
            return;
        }
    }
    
    // Procesar la devolución parcial
    const datosDevolucion = {
        VentaId: ventaActual.id,
        TipoDevolucion: 'Parcial',
        Motivo: motivoFinal,
        MontoDevolucion: totalDevolucion,
        DetallesDevolucion: detallesDevolucion
    };
    
    procesarDevolucion(datosDevolucion);
}

function procesarDevolucion(datosDevolucion) {
    // Mostrar indicador de carga
    const btnProcesar = event.target;
    const textoOriginal = btnProcesar.innerHTML;
    btnProcesar.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Procesando...';
    btnProcesar.disabled = true;
    
    fetch('/Ventas/ProcesarDevolucion', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(datosDevolucion)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert(`Devolución procesada exitosamente.\nID de Devolución: ${data.devolucionId}\nMonto devuelto: ₡${data.montoDevuelto.toLocaleString()}`);
            
            // Cerrar modales
            const modales = document.querySelectorAll('.modal');
            modales.forEach(modal => {
                const modalInstance = bootstrap.Modal.getInstance(modal);
                if (modalInstance) modalInstance.hide();
            });
            
            // Limpiar formulario
            document.getElementById('ventaId').value = '';
            document.getElementById('resultadoVenta').style.display = 'none';
            ventaActual = null;
        } else {
            alert('Error al procesar la devolución: ' + data.error);
        }
    })
    .catch(error => {
        alert('Error al conectar con el servidor: ' + error.message);
    })
    .finally(() => {
        // Restaurar botón
        btnProcesar.innerHTML = textoOriginal;
        btnProcesar.disabled = false;
    });
}

// Manejar cambio de motivo para mostrar campo "Otro"
document.getElementById('motivoTotal').addEventListener('change', function() {
    const div = document.getElementById('otroMotivoTotalDiv');
    div.style.display = this.value === 'Otro' ? 'block' : 'none';
});

document.getElementById('motivoParcial').addEventListener('change', function() {
    const div = document.getElementById('otroMotivoParcialDiv');
    div.style.display = this.value === 'Otro' ? 'block' : 'none';
});

// Permitir buscar con Enter
document.getElementById('ventaId').addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
        buscarVenta();
    }
});

// Auto-buscar si hay ventaId en la URL
document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    const ventaId = urlParams.get('ventaId');
    
    if (ventaId) {
        document.getElementById('ventaId').value = ventaId;
        buscarVenta();
    }
});
</script>
