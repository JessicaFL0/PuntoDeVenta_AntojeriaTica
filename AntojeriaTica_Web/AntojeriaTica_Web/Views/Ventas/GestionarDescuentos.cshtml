@model List<AntojeriaTica_Web.Models.DescuentoModel>

@{
    ViewData["Title"] = "Gestión de Descuentos";
}

<h2 class="mb-4">Gestión de Descuentos</h2>

@if (!string.IsNullOrEmpty(ViewBag.Error as string))
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Valor</th>
            <th>Código Cupón</th>
            <th>Vigencia</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.Nombre</td>
                <td>@d.Tipo</td>
                <td>@(d.Tipo == "Porcentaje" ? $"{d.Valor}%" : $"₡{d.Valor}")</td>
                <td>@(string.IsNullOrEmpty(d.CodigoCupon) ? "-" : d.CodigoCupon)</td>
                <td>@d.FechaInicio.ToShortDateString() - @d.FechaFin.ToShortDateString()</td>
                <td>
                    @if (d.Estado == "Activo")
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else if (d.Estado == "Inactivo")
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Vencido</span>
                    }
                </td>
                <td>
                    <form asp-action="CambiarEstadoDescuento" asp-controller="Ventas" method="post">
                        <input type="hidden" name="id" value="@d.IdDescuento" />
                        <button type="submit" class="btn btn-sm btn-warning">
                            @(d.Estado == "Activo" ? "Desactivar" : "Activar")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<h4 class="mt-4">Agregar Nuevo Descuento</h4>
<form asp-action="AgregarDescuento" asp-controller="Ventas" method="post">
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input type="text" name="Nombre" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Tipo</label>
        <select name="Tipo" class="form-select" required>
            <option value="Porcentaje">Porcentaje</option>
            <option value="MontoFijo">Monto Fijo</option>
            <option value="Cupon">Cupón</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Valor</label>
        <input type="number" step="0.01" name="Valor" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Código de Cupón (opcional)</label>
        <input type="text" name="CodigoCupon" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Fecha de Inicio</label>
        <input type="date" name="FechaInicio" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Fecha de Fin</label>
        <input type="date" name="FechaFin" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Restricciones (opcional)</label>
        <textarea name="Restricciones" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Agregar Descuento</button>
</form>
