@model AntojeriaTica_Web.Models.VentaCompleta
@{
    ViewData["Title"] = "Comprobante de Venta";
    Layout = null; // Sin layout para impresión
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Comprobante de Venta #@Model.Id</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Arial', sans-serif;
            font-size: 12px;
            margin: 20px;
        }
        
        .comprobante {
            max-width: 400px;
            margin: 0 auto;
            border: 2px solid #000;
            padding: 20px;
        }
        
        .header {
            text-align: center;
            margin-bottom: 20px;
            border-bottom: 1px solid #000;
            padding-bottom: 15px;
        }
        
        .empresa {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        
        .info-venta {
            margin-bottom: 15px;
        }
        
        .info-venta div {
            display: flex;
            justify-content: space-between;
            margin-bottom: 3px;
        }
        
        .productos {
            border-top: 1px dashed #000;
            border-bottom: 1px dashed #000;
            padding: 10px 0;
            margin: 15px 0;
        }
        
        .producto {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
        }
        
        .producto-info {
            flex: 1;
        }
        
        .precio {
            font-weight: bold;
            text-align: right;
        }
        
        .total {
            font-size: 16px;
            font-weight: bold;
            text-align: center;
            margin-top: 15px;
            border-top: 2px solid #000;
            padding-top: 10px;
        }
        
        .footer {
            text-align: center;
            margin-top: 20px;
            font-size: 10px;
        }
        
        @@media print {
            body {
                margin: 0;
            }
            
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="no-print text-center mb-3">
        <button class="btn btn-primary" onclick="window.print()">
            <i class="fas fa-print"></i> Imprimir
        </button>
        <button class="btn btn-secondary" onclick="window.close()">
            <i class="fas fa-times"></i> Cerrar
        </button>
    </div>

    <div class="comprobante">
        <div class="header">
            <div class="empresa">ANTOJERÍA TICA</div>
            <div>Punto de Venta</div>
            <div>Tel: (506) 1234-5678</div>
        </div>

        @if (Model.Id > 0)
        {
            <div class="info-venta">
                <div>
                    <span>Comprobante:</span>
                    <span><strong>#@Model.Id</strong></span>
                </div>
                <div>
                    <span>Fecha:</span>
                    <span>@Model.Fecha.ToString("dd/MM/yyyy")</span>
                </div>
                <div>
                    <span>Hora:</span>
                    <span>@Model.Fecha.ToString("HH:mm:ss")</span>
                </div>
                <div>
                    <span>Método Pago:</span>
                    <span><strong>@Model.MetodoPago</strong></span>
                </div>
            </div>

            <div class="productos">
                <div style="text-align: center; margin-bottom: 10px;">
                    <strong>PRODUCTOS VENDIDOS</strong>
                </div>
                
                @foreach (var detalle in Model.Detalles)
                {
                    <div class="producto">
                        <div class="producto-info">
                            <div><strong>@detalle.ProductoNombre</strong></div>
                            <div>Código: @detalle.ProductoCodigo</div>
                            <div>@detalle.Cantidad x ₡@detalle.PrecioUnitario.ToString("N2")</div>
                        </div>
                        <div class="precio">
                            ₡@detalle.Subtotal.ToString("N2")
                        </div>
                    </div>
                    <hr style="margin: 5px 0; border-style: dashed;">
                }
            </div>

            <div class="total">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span>TOTAL A PAGAR:</span>
                    <span style="font-size: 20px;">₡@Model.Total.ToString("N2")</span>
                </div>
            </div>

            <div class="info-venta" style="margin-top: 15px;">
                <div>
                    <span>Total productos:</span>
                    <span>@Model.Detalles.Count</span>
                </div>
                <div>
                    <span>Cantidad total:</span>
                    <span>@Model.Detalles.Sum(d => d.Cantidad)</span>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center">
                <strong>Error:</strong> No se encontró información de esta venta.
            </div>
        }

        <div class="footer">
            <p>*** GRACIAS POR SU COMPRA ***</p>
            <p>¡Vuelva pronto!</p>
            <hr>
            <p>Este comprobante fue reimpreso el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
    </div>

    <script>
        // Auto-imprimir al cargar si viene de una búsqueda
        window.addEventListener('load', function() {
            // Pequeño delay para que cargue completamente
            setTimeout(function() {
                if (window.location.search.includes('autoprint=true')) {
                    window.print();
                }
            }, 500);
        });
    </script>
</body>
</html>
