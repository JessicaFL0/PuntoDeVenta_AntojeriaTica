@model AntojeriaTica_Web.Models.ProductoModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container pt-5 mt-5">
<h2>Registrar Producto</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="RegistrarProducto" asp-controller="Inventario" method="post">
    <div class="mb-3">
        <label class="form-label">Código</label>
        <input asp-for="Codigo" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Precio Unitario</label>
        <input asp-for="PrecioUnitario" class="form-control" type="number" step="0.01" />
    </div>
    <div class="mb-3">
        <label class="form-label">Existencias</label>
        <input asp-for="Existencias" class="form-control" type="number" />
    </div>

    <button type="submit" class="btn btn-primary">Registrar</button>
    <a asp-action="ListarProductos" class="btn btn-secondary">Volver</a>
</form>
</div>
