@model AntojeriaTica_Web.Models.PedidoModel

@{
    ViewData["Title"] = $"Detalle del Pedido #{Model.NumeroPedido}";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-receipt"></i> Detalle del Pedido #@Model.NumeroPedido</h2>
                <div>
                    @if (Model.Estado != "Entregado" && Model.Estado != "Cancelado")
                    {
                        <div class="btn-group me-2" role="group">
                            @if (Model.Estado == "En preparación")
                            {
                                <button type="button" class="btn btn-success" onclick="actualizarEstado('Listo')">
                                    <i class="fas fa-check"></i> Marcar como Listo
                                </button>
                            }
                            @if (Model.Estado == "Listo")
                            {
                                <button type="button" class="btn btn-primary" onclick="actualizarEstado('Entregado')">
                                    <i class="fas fa-hand-holding"></i> Marcar como Entregado
                                </button>
                            }
                        </div>
                    }
                    <a href="@Url.Action("Seguimiento")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Volver al Seguimiento
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-list"></i> Lista Pedidos
                    </a>
                </div>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <!-- Información del Pedido -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Información General</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <dl class="row">
                                        <dt class="col-sm-4">Número:</dt>
                                        <dd class="col-sm-8"><strong>@Model.NumeroPedido</strong></dd>
                                        
                                        <dt class="col-sm-4">Fecha:</dt>
                                        <dd class="col-sm-8">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
                                        
                                        <dt class="col-sm-4">Tipo:</dt>
                                        <dd class="col-sm-8">
                                            <span class="badge bg-info">@Model.TipoPedido</span>
                                        </dd>
                                        
                                        <dt class="col-sm-4">Estado:</dt>
                                        <dd class="col-sm-8">
                                            @switch (Model.Estado)
                                            {
                                                case "En preparación":
                                                    <span class="badge bg-warning text-dark fs-6">@Model.Estado</span>
                                                    break;
                                                case "Listo":
                                                    <span class="badge bg-success fs-6">@Model.Estado</span>
                                                    break;
                                                case "Entregado":
                                                    <span class="badge bg-primary fs-6">@Model.Estado</span>
                                                    break;
                                                case "Cancelado":
                                                    <span class="badge bg-danger fs-6">@Model.Estado</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary fs-6">@Model.Estado</span>
                                                    break;
                                            }
                                        </dd>
                                    </dl>
                                </div>
                                <div class="col-md-6">
                                    <dl class="row">
                                        <dt class="col-sm-4">Cliente:</dt>
                                        <dd class="col-sm-8">@(Model.Cliente ?? "No especificado")</dd>
                                        
                                        <dt class="col-sm-4">Mesa:</dt>
                                        <dd class="col-sm-8">@(Model.Mesa ?? "No especificada")</dd>
                                        
                                        @if (!string.IsNullOrEmpty(Model.Observaciones))
                                        {
                                            <dt class="col-sm-4">Observaciones:</dt>
                                            <dd class="col-sm-8">@Model.Observaciones</dd>
                                        }
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Detalles de Productos -->
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Productos del Pedido</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.Detalles.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Código</th>
                                                <th>Producto</th>
                                                <th>Cantidad</th>
                                                <th>Precio Unit.</th>
                                                <th>Subtotal</th>
                                                <th>Impuesto</th>
                                                <th>Total</th>
                                                <th>Observaciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var detalle in Model.Detalles)
                                            {
                                                <tr>
                                                    <td><small class="text-muted">@detalle.ProductoCodigo</small></td>
                                                    <td><strong>@detalle.ProductoNombre</strong></td>
                                                    <td><span class="badge bg-light text-dark">@detalle.Cantidad</span></td>
                                                    <td>@detalle.PrecioUnitario.ToString("C")</td>
                                                    <td>@detalle.Subtotal.ToString("C")</td>
                                                    <td>@detalle.Impuesto.ToString("C")</td>
                                                    <td><strong>@((detalle.Subtotal + detalle.Impuesto).ToString("C"))</strong></td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(detalle.ObservacionesItem))
                                                        {
                                                            <small class="text-muted">@detalle.ObservacionesItem</small>
                                                        }
                                                        else
                                                        {
                                                            <small class="text-muted">-</small>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-box-open fa-2x mb-2"></i>
                                    <p>No hay productos en este pedido</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Resumen Financiero -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Resumen Financiero</h5>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-6">Subtotal:</dt>
                                <dd class="col-6 text-end">@Model.Subtotal.ToString("C")</dd>
                                
                                <dt class="col-6">Impuesto (13%):</dt>
                                <dd class="col-6 text-end">@Model.Impuesto.ToString("C")</dd>
                                
                                @if (Model.Descuento > 0)
                                {
                                    <dt class="col-6">Descuento:</dt>
                                    <dd class="col-6 text-end text-success">-@Model.Descuento.ToString("C")</dd>
                                }
                            </dl>
                            <hr>
                            <dl class="row">
                                <dt class="col-6 h5">Total:</dt>
                                <dd class="col-6 text-end h5"><strong>@Model.Total.ToString("C")</strong></dd>
                            </dl>
                        </div>
                    </div>

                    <!-- Estados Disponibles -->
                    @if (Model.Estado != "Entregado" && Model.Estado != "Cancelado")
                    {
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Cambiar Estado</h5>
                            </div>
                            <div class="card-body">
                                <p class="text-muted small">Estado actual: <strong>@Model.Estado</strong></p>
                                
                                @if (Model.Estado == "En preparación")
                                {
                                    <form asp-action="ActualizarEstado" method="post" class="d-inline">
                                        <input type="hidden" name="pedidoId" value="@Model.Id" />
                                        <input type="hidden" name="nuevoEstado" value="Listo" />
                                        <button type="submit" class="btn btn-success btn-sm w-100 mb-2">
                                            <i class="fas fa-check"></i> Marcar como Listo
                                        </button>
                                    </form>
                                }
                                
                                @if (Model.Estado == "Listo")
                                {
                                    <form asp-action="ActualizarEstado" method="post" class="d-inline">
                                        <input type="hidden" name="pedidoId" value="@Model.Id" />
                                        <input type="hidden" name="nuevoEstado" value="Entregado" />
                                        <button type="submit" class="btn btn-primary btn-sm w-100 mb-2">
                                            <i class="fas fa-shipping-fast"></i> Marcar como Entregado
                                        </button>
                                    </form>
                                }
                                
                                <form asp-action="ActualizarEstado" method="post" class="d-inline">
                                    <input type="hidden" name="pedidoId" value="@Model.Id" />
                                    <input type="hidden" name="nuevoEstado" value="Cancelado" />
                                    <button type="submit" class="btn btn-danger btn-sm w-100" 
                                            onclick="return confirm('¿Está seguro de cancelar este pedido?')">
                                        <i class="fas fa-times"></i> Cancelar Pedido
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function actualizarEstado(nuevoEstado) {
    Swal.fire({
        title: `¿Marcar como ${nuevoEstado}?`,
        text: `¿Está seguro que desea cambiar el estado del pedido a "${nuevoEstado}"?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Sí, cambiar estado',
        cancelButtonText: 'Cancelar'
    }).then((result) => {
        if (result.isConfirmed) {
            $.ajax({
                url: '@Url.Action("ActualizarEstado")',
                type: 'POST',
                data: {
                    pedidoId: @Model.Id,
                    nuevoEstado: nuevoEstado
                },
                success: function(response) {
                    if (response.success) {
                        Swal.fire('¡Actualizado!', response.message, 'success').then(() => {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                },
                error: function() {
                    Swal.fire('Error', 'No se pudo actualizar el estado del pedido', 'error');
                }
            });
        }
    });
}

// Auto-actualizar cada 60 segundos
setInterval(function() {
    location.reload();
}, 60000);
</script>
}