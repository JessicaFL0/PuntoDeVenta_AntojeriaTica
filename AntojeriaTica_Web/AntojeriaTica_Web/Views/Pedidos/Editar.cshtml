@model AntojeriaTica_Web.Models.PedidoModel

@{
    ViewData["Title"] = "Editar pedido";
    var minutosTrans = ViewBag.MinutosTranscurridos as int? ?? 0;
}

<div class="container">
    <div class="row">
        <div class="col-12 col-lg-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-pen"></i> Editar pedido</span>
                    <small class="text-muted">Tiempo transcurrido: @minutosTrans min (límite 5)</small>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                    <form asp-action="Editar" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-3">
                            <label asp-for="Cliente" class="form-label"></label>
                            <input asp-for="Cliente" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Mesa" class="form-label"></label>
                            <input asp-for="Mesa" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Observaciones" class="form-label"></label>
                            <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="alert alert-info">
                            Solo se pueden editar estos campos. El estado del pedido no se puede modificar desde aquí.
                        </div>

                        <hr />
                        <h5>Productos</h5>
                        <p class="text-muted">Puede editar los productos durante los primeros 5 minutos.</p>
                        <div id="detalle-container">
                            @for (int i = 0; i < Model.Detalles.Count; i++)
                            {
                                <div class="row g-2 align-items-end mb-2 detalle-row">
                                    <div class="col-6 col-md-4">
                                        <label class="form-label">Producto</label>
                                        <select name="Detalles[@i].ProductoId" class="form-select producto-select">
                                            @foreach (var p in (IEnumerable<dynamic>)ViewBag.ProductosCompletos)
                                            {
                                                int idp = (int)p.IdProducto;
                                                decimal prec = (decimal)p.PrecioUnitario;
                                                if (Model.Detalles[i].ProductoId == idp)
                                                {
                                                    <option value="@idp" data-precio="@prec" selected="selected">@p.Nombre</option>
                                                }
                                                else
                                                {
                                                    <option value="@idp" data-precio="@prec">@p.Nombre</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-6 col-md-2">
                                        <label class="form-label">Cantidad</label>
                                        <input type="number" min="1" name="Detalles[@i].Cantidad" value="@Model.Detalles[i].Cantidad" class="form-control" />
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label">Precio</label>
                                        <input type="number" step="0.01" min="0.01" name="Detalles[@i].PrecioUnitario" value="@Model.Detalles[i].PrecioUnitario" class="form-control" />
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label">Observaciones</label>
                                        <input type="text" name="Detalles[@i].ObservacionesItem" value="@Model.Detalles[i].ObservacionesItem" class="form-control" />
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="mb-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-agregar-item">
                                <i class="fas fa-plus"></i> Agregar producto
                            </button>
                        </div>
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Guardar cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function(){
    const productos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ProductosCompletos ?? new List<object>()));
        const cont = document.getElementById('detalle-container');
        const btnAdd = document.getElementById('btn-agregar-item');
        function optionList(){
            return productos.map(p=>{
                const idp = p.IdProducto ?? p.idProducto;
                const nom = p.Nombre ?? p.nombre;
                const precio = p.PrecioUnitario ?? p.precioUnitario ?? 0;
                return `<option value="${idp}" data-precio="${precio}">${nom}</option>`;
            }).join('');
        }
        function setPriceFromSelect(selectEl){
            const opt = selectEl.options[selectEl.selectedIndex];
            const precio = parseFloat(opt.getAttribute('data-precio') || '0');
            const row = selectEl.closest('.detalle-row');
            if (!row) return;
            const precioInput = row.querySelector('input[name$=".PrecioUnitario"]');
            if (precioInput) precioInput.value = precio.toFixed(2);
        }
        btnAdd?.addEventListener('click', ()=>{
            const idx = cont.querySelectorAll('.detalle-row').length;
            const row = document.createElement('div');
            row.className = 'row g-2 align-items-end mb-2 detalle-row';
            row.innerHTML = `
                <div class="col-6 col-md-4">
                    <label class="form-label">Producto</label>
                    <select name="Detalles[${idx}].ProductoId" class="form-select producto-select">${optionList()}</select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Cantidad</label>
                    <input type="number" min="1" name="Detalles[${idx}].Cantidad" value="1" class="form-control" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label">Precio</label>
                    <input type="number" step="0.01" min="0.01" name="Detalles[${idx}].PrecioUnitario" value="0.00" class="form-control" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label">Observaciones</label>
                    <input type="text" name="Detalles[${idx}].ObservacionesItem" class="form-control" />
                </div>`;
            cont.appendChild(row);
            const sel = row.querySelector('select.producto-select');
            if (sel){
                setPriceFromSelect(sel);
                sel.addEventListener('change', (e)=> setPriceFromSelect(e.target));
            }
        });

        // Inicializar selects existentes
        document.querySelectorAll('select.producto-select').forEach(sel => {
            sel.addEventListener('change', (e)=> setPriceFromSelect(e.target));
            // Si precio está vacío o 0, setear por defecto
            setPriceFromSelect(sel);
        });
    })();
 </script>
