@model List<AntojeriaTica_Web.Models.PedidoResumenModel>

@{
    ViewData["Title"] = "Vista de Cocina";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-utensils"></i> Vista de Cocina - Pedidos en Preparación</h2>
                <div>
                    <button class="btn btn-info" onclick="location.reload()">
                        <i class="fas fa-sync-alt"></i> Actualizar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Vista Normal
                    </a>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model.Any())
            {
                <div class="row">
                    @foreach (var pedido in Model.OrderBy(p => p.Fecha))
                    {
                        <div class="col-lg-4 col-md-6 mb-4">
                            <div class="card border-warning h-100">
                                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">
                                        <i class="fas fa-receipt"></i> @pedido.NumeroPedido
                                    </h5>
                                    <span class="badge bg-dark">@pedido.TipoPedido</span>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <small class="text-muted">Hora:</small><br>
                                            <strong>@pedido.Fecha.ToString("HH:mm")</strong>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted">Tiempo:</small><br>
                                            <span class="badge @(DateTime.Now.Subtract(pedido.Fecha).TotalMinutes > 15 ? "bg-danger" : "bg-warning")">
                                                @((int)DateTime.Now.Subtract(pedido.Fecha).TotalMinutes) min
                                            </span>
                                        </div>
                                    </div>
                                    
                                    @if (!string.IsNullOrEmpty(pedido.Cliente))
                                    {
                                        <p class="mb-1">
                                            <small class="text-muted">Cliente:</small><br>
                                            <strong>@pedido.Cliente</strong>
                                        </p>
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(pedido.Mesa))
                                    {
                                        <p class="mb-1">
                                            <small class="text-muted">Mesa:</small><br>
                                            <span class="badge bg-info">Mesa @pedido.Mesa</span>
                                        </p>
                                    }
                                    
                                    <p class="mb-2">
                                        <small class="text-muted">Items:</small><br>
                                        <span class="badge bg-light text-dark">@pedido.CantidadItems productos</span>
                                    </p>
                                    
                                    @if (!string.IsNullOrEmpty(pedido.Observaciones))
                                    {
                                        <div class="alert alert-info py-2 px-3 mb-3">
                                            <small><i class="fas fa-info-circle"></i> @pedido.Observaciones</small>
                                        </div>
                                    }
                                </div>
                                <div class="card-footer">
                                    <div class="d-grid gap-2">
                                        <a asp-action="Detalle" asp-route-id="@pedido.Id" 
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-eye"></i> Ver Detalle
                                        </a>
                                        <form asp-action="ActualizarEstado" method="post" class="d-inline">
                                            <input type="hidden" name="pedidoId" value="@pedido.Id" />
                                            <input type="hidden" name="nuevoEstado" value="Listo" />
                                            <button type="submit" class="btn btn-success btn-sm w-100">
                                                <i class="fas fa-check"></i> Marcar como Listo
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-utensils fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">¡Excelente trabajo!</h4>
                    <p class="text-muted">No hay pedidos pendientes en la cocina</p>
                    <p class="text-muted">Todos los pedidos están listos o entregados</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        setTimeout(function() {
            location.reload();
        }, 15000);
        document.addEventListener('DOMContentLoaded', function() {
            const pedidosUrgentes = document.querySelectorAll('.badge.bg-danger');
            if (pedidosUrgentes.length > 0) {
                console.log('Hay pedidos pendientes hace más de 15 minutos');
            }
        });
    </script>
}

<style>
    .card {
        transition: transform 0.2s;
    }
    .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    
    .badge.bg-danger {
        animation: pulse 2s infinite;
    }
    
    @@keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }
</style>
