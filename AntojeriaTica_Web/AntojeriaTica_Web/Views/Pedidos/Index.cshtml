@model List<AntojeriaTica_Web.Models.PedidoResumenModel>

@{
    ViewData["Title"] = "Gestión de Pedidos";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-shopping-cart"></i> Gestión de Pedidos</h2>
                <div>
                    <a asp-action="RegistrarPedido" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Nuevo Pedido
                    </a>
                    <a asp-action="Cocina" class="btn btn-warning">
                        <i class="fas fa-utensils"></i> Vista Cocina
                    </a>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Lista de Pedidos</h5>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>@Html.DisplayNameFor(m => m.First().NumeroPedido)</th>
                                        <th>@Html.DisplayNameFor(m => m.First().Fecha)</th>
                                        <th>@Html.DisplayNameFor(m => m.First().Cliente)</th>
                                        <th>@Html.DisplayNameFor(m => m.First().Mesa)</th>
                                        <th>@Html.DisplayNameFor(m => m.First().TipoPedido)</th>
                                        <th>@Html.DisplayNameFor(m => m.First().Estado)</th>
                                        <th>@Html.DisplayNameFor(m => m.First().CantidadItems)</th>
                                        <th>@Html.DisplayNameFor(m => m.First().Total)</th>
                                        <th>@Html.DisplayNameFor(m => m.First().Usuario)</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pedido in Model)
                                    {
                                        <tr>
                                            <td><strong>@pedido.NumeroPedido</strong></td>
                                            <td>@pedido.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@(pedido.Cliente ?? "N/A")</td>
                                            <td>@(pedido.Mesa ?? "N/A")</td>
                                            <td>
                                                <span class="badge bg-info">@pedido.TipoPedido</span>
                                            </td>
                                            <td>
                                                @switch (pedido.Estado)
                                                {
                                                    case "En preparación":
                                                        <span class="badge bg-warning text-dark">@pedido.Estado</span>
                                                        break;
                                                    case "Listo":
                                                        <span class="badge bg-success">@pedido.Estado</span>
                                                        break;
                                                    case "Entregado":
                                                        <span class="badge bg-primary">@pedido.Estado</span>
                                                        break;
                                                    case "Cancelado":
                                                        <span class="badge bg-danger">@pedido.Estado</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">@pedido.Estado</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark">@pedido.CantidadItems items</span>
                                            </td>
                                            <td><strong>@pedido.Total.ToString("C")</strong></td>
                                            <td>@pedido.Usuario</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Detalle" asp-route-id="@pedido.Id" 
                                                       class="btn btn-sm btn-outline-primary" title="Ver Detalle">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    @if (pedido.Estado != "Entregado" && pedido.Estado != "Cancelado")
                                                    {
                                                        <a asp-action="ActualizarEstado" asp-route-id="@pedido.Id" 
                                                           class="btn btn-sm btn-outline-warning" title="Cambiar Estado">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No hay pedidos registrados</h5>
                            <p class="text-muted">Comienza registrando tu primer pedido</p>
                            <a asp-action="RegistrarPedido" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Registrar Primer Pedido
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-refresh cada 30 segundos para mostrar actualizaciones en tiempo real
        setTimeout(function() {
            location.reload();
        }, 30000);
    </script>
}
