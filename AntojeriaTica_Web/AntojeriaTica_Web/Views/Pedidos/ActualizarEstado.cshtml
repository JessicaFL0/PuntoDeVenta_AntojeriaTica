@{
    ViewData["Title"] = "Actualizar Estado del Pedido";
    var pedidoId = ViewBag.PedidoId ?? 0;
    var estadoActual = ViewBag.EstadoActual?.ToString();
    var pedidoInfo = ViewBag.PedidoInfo as AntojeriaTica_Web.Models.PedidoModel;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-edit"></i> Actualizar Estado del Pedido
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Mostrar mensajes de error -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong><i class="fas fa-exclamation-triangle"></i> Error:</strong>
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Mostrar mensajes de éxito -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong><i class="fas fa-check-circle"></i> Éxito:</strong>
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (pedidoInfo != null)
                    {
                        <div class="mb-4">
                            <h6>Información del Pedido:</h6>
                            <ul class="list-unstyled">
                                <li><strong>Número:</strong> @pedidoInfo.NumeroPedido</li>
                                <li><strong>Fecha:</strong> @pedidoInfo.Fecha.ToString("dd/MM/yyyy HH:mm")</li>
                                @if (!string.IsNullOrEmpty(pedidoInfo.Cliente))
                                {
                                    <li><strong>Cliente:</strong> @pedidoInfo.Cliente</li>
                                }
                                @if (!string.IsNullOrEmpty(pedidoInfo.Mesa))
                                {
                                    <li><strong>Mesa:</strong> @pedidoInfo.Mesa</li>
                                }
                                <li><strong>Estado actual:</strong> 
                                    <span class="badge bg-warning">@pedidoInfo.Estado</span>
                                </li>
                            </ul>
                        </div>
                    }

                    <form asp-action="ActualizarEstado" method="post" id="formActualizarEstado">
                        <input type="hidden" name="pedidoId" value="@pedidoId" />
                        
                        <div class="mb-3">
                            <label for="nuevoEstado" class="form-label">Nuevo Estado:</label>
                            <select name="nuevoEstado" id="nuevoEstado" class="form-select" required>
                                <option value="">Seleccionar nuevo estado...</option>
                                @if (ViewBag.Estados != null)
                                {
                                    @foreach (var estado in (SelectList)ViewBag.Estados)
                                    {
                                        if (estado.Text != estadoActual)
                                        {
                                            <option value="@estado.Text">@estado.Text</option>
                                        }
                                    }
                                }
                            </select>
                            <div class="invalid-feedback">
                                Por favor seleccione un nuevo estado.
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Actualizar Estado
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Debug: mostrar qué estados están disponibles
        console.log('Estados disponibles:', @Html.Raw(Json.Serialize(ViewBag.Estados)));
        console.log('Estado actual:', '@ViewBag.EstadoActual');
        
        document.getElementById('formActualizarEstado').addEventListener('submit', function(e) {
            const nuevoEstado = document.getElementById('nuevoEstado').value;
            console.log('Formulario enviado con nuevoEstado:', nuevoEstado);
            
            if (!nuevoEstado || nuevoEstado === '') {
                e.preventDefault();
                alert('Por favor seleccione un nuevo estado.');
                
                // Mostrar feedback de validación
                const select = document.getElementById('nuevoEstado');
                select.classList.add('is-invalid');
                
                return false;
            }
            
            console.log('Enviando formulario con estado:', nuevoEstado);
        });
        
        // Debug: agregar listener para cambios en el select
        document.getElementById('nuevoEstado').addEventListener('change', function() {
            console.log('Estado seleccionado:', this.value);
            this.classList.remove('is-invalid');
        });
    </script>
}