@model List<AntojeriaTica_Web.Models.UsuarioModel>

@{
    ViewData["Title"] = "Lista de Usuarios";
}

@Html.AntiForgeryToken()

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Gestión de Usuarios</h4>
                    <a asp-action="RegistrarCuenta" class="btn btn-success">
                        <i class="bi bi-person-plus"></i> Nuevo Usuario
                    </a>
                </div>
                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
                        </div>
                    }

                    @if (TempData["Mensaje"] != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> @TempData["Mensaje"]
                        </div>
                    }

                    @if (ViewBag.UsuariosJson != null)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Nombre Completo</th>
                                        <th>Correo</th>
                                        <th>Cédula</th>
                                        <th>Estado</th>
                                        <th>Rol</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="usuariosTableBody">
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-4">
                            <h6>Respuesta de la API (Debug):</h6>
                            <pre class="bg-light p-3 rounded"
                                style="max-height: 300px; overflow-y: auto;">@ViewBag.UsuariosJson</pre>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> No hay usuarios para mostrar.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (ViewBag.UsuariosJson != null)
                {
                    <text>
                        try {
                                                                                                                                                                                                                                                                                    var usuariosData = @Html.Raw(ViewBag.UsuariosJson);
                        var usuarios = usuariosData.users || usuariosData;

                        var tbody = document.getElementById('usuariosTableBody');
                        tbody.innerHTML = '';

                        if (Array.isArray(usuarios)) {
                            usuarios.forEach(function (usuario) {
                                console.log('Usuario:', usuario);
                                console.log('ID del usuario:', usuario.idUsuario);

                                var userId = usuario.idUsuario || usuario.IdUsuario;
                                console.log('ID final a usar:', userId);

                                var row = document.createElement('tr');
                                var tdId = document.createElement('td');
                                tdId.textContent = userId || 'N/A';

                                var tdNombre = document.createElement('td');
                                tdNombre.textContent = usuario.nombreCompleto || usuario.NombreCompleto || 'N/A';

                                var tdCorreo = document.createElement('td');
                                tdCorreo.textContent = usuario.correo || usuario.Correo || 'N/A';

                                var tdCedula = document.createElement('td');
                                tdCedula.textContent = usuario.cedula || usuario.Cedula || 'N/A';

                                var tdEstado = document.createElement('td');
                                var spanEstado = document.createElement('span');
                                var estado = usuario.estado || usuario.Estado || 'N/A';
                                spanEstado.className = estado === 'Activo' ? 'badge bg-success' : 'badge bg-danger';
                                spanEstado.textContent = estado;
                                tdEstado.appendChild(spanEstado);

                                var tdRol = document.createElement('td');
                                tdRol.textContent = usuario.nombreRol || usuario.NombreRol || usuario.idRol || usuario.IdRol || 'N/A';

                                var tdAcciones = document.createElement('td');

                                var btnEditar = document.createElement('a');
                                btnEditar.href = '@Url.Action("ActualizarUsuario", "Login")?id=' + userId;
                                btnEditar.className = 'btn btn-sm btn-primary me-1';
                                btnEditar.innerHTML = '<i class="bi bi-pencil"></i> Editar';

                                var btnEliminar = document.createElement('button');
                                btnEliminar.className = 'btn btn-sm btn-danger';
                                btnEliminar.id = 'btnEliminar' + userId;
                                btnEliminar.innerHTML = '<i class="bi bi-trash"></i> Eliminar';

                                btnEliminar.addEventListener('click', function () {
                                    console.log('Click en eliminar, userId:', userId);
                                    eliminarUsuario(userId);
                                });

                                tdAcciones.appendChild(btnEditar);
                                tdAcciones.appendChild(btnEliminar);

                                row.appendChild(tdId);
                                row.appendChild(tdNombre);
                                row.appendChild(tdCorreo);
                                row.appendChild(tdCedula);
                                row.appendChild(tdEstado);
                                row.appendChild(tdRol);
                                row.appendChild(tdAcciones);
                                tbody.appendChild(row);
                            });
                                                                                                                                                                                                                                                                                    } else {
                            tbody.innerHTML = '<tr><td colspan="7" class="text-center">No se pudieron cargar los usuarios</td></tr>';
                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                } catch (e) {
                            console.error('Error al procesar usuarios:', e);
                        document.getElementById('usuariosTableBody').innerHTML =
                        '<tr><td colspan="7" class="text-center text-danger">Error al cargar los datos</td></tr>';
                                                                                                                                                                                                                                                                                }
                    </text>
            }
                                                                                                                                        });

        function eliminarUsuario(id) {
            console.log('Función eliminarUsuario llamada con ID:', id);
            console.log('Tipo de ID:', typeof id);

            if (confirm('¿Está seguro de que desea eliminar este usuario?')) {
                const button = document.getElementById(`btnEliminar${id}`);
                const originalText = button.innerHTML;
                button.innerHTML = '<i class="bi bi-hourglass-split"></i> Eliminando...';
                button.disabled = true;

                var formData = new FormData();
                formData.append('id', id);

                fetch('@Url.Action("EliminarUsuario", "Login")', {
                    method: 'POST',
                    body: formData
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert('Usuario eliminado exitosamente');

                            window.location.reload();
                        } else {
                            alert('Error: ' + data.message);

                            button.innerHTML = originalText;
                            button.disabled = false;
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Error de conexión. Inténtelo de nuevo.');

                        button.innerHTML = originalText;
                        button.disabled = false;
                    });
            }
        }
    </script>
}
