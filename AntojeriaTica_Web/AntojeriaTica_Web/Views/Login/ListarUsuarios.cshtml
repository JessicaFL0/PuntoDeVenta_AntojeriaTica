@model List<AntojeriaTica_Web.Models.UsuarioModel>

@{
    ViewData["Title"] = "Lista de Usuarios";
}

@Html.AntiForgeryToken()

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Gestión de Usuarios</h4>
                    <a asp-action="RegistrarCuenta" class="btn btn-success">
                        <i class="bi bi-person-plus"></i> Nuevo Usuario
                    </a>
                </div>
                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
                        </div>
                    }

                    @if (TempData["Mensaje"] != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> @TempData["Mensaje"]
                        </div>
                    }

                    @if (ViewBag.UsuariosJson != null)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Nombre Completo</th>
                                        <th>Correo</th>
                                        <th>Cédula</th>
                                        <th>Estado</th>
                                        <th>Rol</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="usuariosTableBody">
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-4">
                            <h6>Respuesta de la API (Debug):</h6>
                            <pre class="bg-light p-3 rounded"
                                style="max-height: 300px; overflow-y: auto;">@ViewBag.UsuariosJson</pre>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> No hay usuarios para mostrar.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            try {
                var usuariosData = @Html.Raw(ViewBag.UsuariosJson ?? "[]");
                var usuarios = usuariosData.users || usuariosData;

                var tbody = document.getElementById('usuariosTableBody');
                tbody.innerHTML = '';

                if (Array.isArray(usuarios)) {
                    usuarios.forEach(function (usuario) {
                        var userId = usuario.idUsuario || usuario.IdUsuario || 'N/A';
                        var row = document.createElement('tr');

                        row.innerHTML = `
                            <td>${userId}</td>
                            <td>${usuario.nombreCompleto || usuario.NombreCompleto || 'N/A'}</td>
                            <td>${usuario.correo || usuario.Correo || 'N/A'}</td>
                            <td>${usuario.cedula || usuario.Cedula || 'N/A'}</td>
                            <td><span class="badge ${usuario.estado === 'Activo' ? 'bg-success' : 'bg-danger'}">${usuario.estado || 'N/A'}</span></td>
                            <td>${usuario.nombreRol || usuario.NombreRol || usuario.idRol || usuario.IdRol || 'N/A'}</td>
                            <td>
                                <a href='@Url.Action("ActualizarUsuario", "Login")?id=${userId}' class='btn btn-sm btn-primary me-1'>
                                    <i class='bi bi-pencil'></i> Editar
                                </a>
                                <button class='btn btn-sm btn-danger' onclick='eliminarUsuario(${userId})'>
                                    <i class='bi bi-trash'></i> Eliminar
                                </button>
                            </td>
                        `;
                        tbody.appendChild(row);
                    });
                } else {
                    tbody.innerHTML = '<tr><td colspan="7" class="text-center">No se pudieron cargar los usuarios</td></tr>';
                }
            } catch (e) {
                console.error('Error al procesar usuarios:', e);
                document.getElementById('usuariosTableBody').innerHTML =
                    '<tr><td colspan="7" class="text-center text-danger">Error al cargar los datos</td></tr>';
            }
        });

        function eliminarUsuario(id) {
            if (confirm('¿Está seguro de que desea eliminar este usuario?')) {
                const button = document.getElementById(`btnEliminar${id}`);
                const originalText = button.innerHTML;
                button.innerHTML = '<i class="bi bi-hourglass-split"></i> Eliminando...';
                button.disabled = true;

                const formData = new FormData();
                formData.append('id', id);

                fetch('@Url.Action("EliminarUsuario", "Login")', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Usuario eliminado exitosamente');
                        window.location.reload();
                    } else {
                        alert('Error: ' + data.message);
                        button.innerHTML = originalText;
                        button.disabled = false;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error de conexión. Inténtelo de nuevo.');
                    button.innerHTML = originalText;
                    button.disabled = false;
                });
            }
        }
    </script>
}
