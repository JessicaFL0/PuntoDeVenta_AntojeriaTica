@model AntojeriaTica_Web.Models.UsuarioModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-scroller">
    <div class="container-fluid page-body-wrapper full-page-wrapper">
        <div class="main-panel">
            <div class="content-wrapper d-flex align-items-center auth px-0">
                <div class="row w-100 mx-0">
                    <div class="col-lg-4 mx-auto">
                        <div class="auth-form-light text-left py-5 px-4 px-sm-5">
                            <h2>Soda Antojería Tica</h2>
                            <h4 class="font-weight-light">Crear Cuenta</h4>

                            <form asp-action="RegistrarCuenta" asp-controller="Login" method="post" class="pt-3">
                                <div class="form-group">
                                    <input type="text" asp-for="NombreCompleto" class="form-control form-control-lg" placeholder="Nombre completo" />
                                </div>
                                <div class="form-group">
                                    <input type="text" asp-for="Cedula" class="form-control form-control-lg" placeholder="Cédula" />
                                </div>
                                <div class="form-group">
                                    <input type="email" asp-for="Correo" class="form-control form-control-lg" placeholder="Correo electrónico" />
                                </div>
                                <div class="form-group">
                                    <input type="password" asp-for="ContrasenaHash" class="form-control form-control-lg" placeholder="Contraseña" />
                                </div>

                                <div class="mt-3">
                                    <button type="submit" class="btn btn-block btn-primary btn-lg font-weight-medium auth-form-btn">
                                        Registrar
                                    </button>
                                </div>
                                <div class="text-center mt-4 font-weight-light">
                                    ¿Ya tienes cuenta? <a href="@Url.Action("IniciarSesion", "Login")" class="text-primary">Iniciar sesión</a>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

