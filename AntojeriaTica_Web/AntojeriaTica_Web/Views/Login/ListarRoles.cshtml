@model List<AntojeriaTica_Web.Models.Rol>

<h2>Lista de Roles</h2>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rol in Model)
        {
            <tr>
                <td>@rol.Nombre</td>
                <td>@rol.Descripcion</td>
                <td>
                    <a class="btn btn-danger" href="@Url.Action("EliminarRol", "Login", new { id = rol.IdRol })"
                       onclick="return confirm('¿Estás seguro de eliminar este rol?')">
                        Eliminar
                    </a>

                </td>
            </tr>
        }
    </tbody>
</table>
