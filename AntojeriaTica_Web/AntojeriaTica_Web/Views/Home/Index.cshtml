@{
    ViewData["Title"] = "Inicio";
    var rol = Context.Session.GetString("NombreRol") ?? string.Empty;
    var isAdmin = rol.ToLowerInvariant().Contains("admin");
    // Datos del negocio para la portada
    var direccion = "C. 6A, Provincia de Alajuela, Alajuela, Costa Rica";
    var hoy = DateTime.Now;
    var horarios = new Dictionary<DayOfWeek, (TimeSpan? Abre, TimeSpan? Cierra)>
    {
        { DayOfWeek.Sunday,    (null, null) }, // Cerrado
        { DayOfWeek.Monday,    (new TimeSpan(8,0,0),  new TimeSpan(20,30,0)) },
        { DayOfWeek.Tuesday,   (new TimeSpan(8,0,0),  new TimeSpan(20,30,0)) },
        { DayOfWeek.Wednesday, (new TimeSpan(8,0,0),  new TimeSpan(20,30,0)) },
        { DayOfWeek.Thursday,  (new TimeSpan(8,0,0),  new TimeSpan(20,30,0)) },
        { DayOfWeek.Friday,    (new TimeSpan(8,0,0),  new TimeSpan(21,0,0)) },
        { DayOfWeek.Saturday,  (new TimeSpan(8,0,0),  new TimeSpan(21,0,0)) }
    };
    var tNow = hoy.TimeOfDay;
    var abreHoy = horarios[hoy.DayOfWeek].Abre;
    var cierraHoy = horarios[hoy.DayOfWeek].Cierra;
    bool abierto = abreHoy.HasValue && cierraHoy.HasValue && tNow >= abreHoy && tNow <= cierraHoy;
    string etiquetaEstado = abierto ? "Abierto" : "Cerrado";
    string iconoEstado = abierto ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger";
}

<div class="container-fluid">
    @if (!isAdmin)
    {

        <div class="row g-4">
            <div class="col-12 col-lg-7">
                <div class="card shadow-sm mb-4">
                    <div class="card-header"><i class="bi bi-geo-alt me-2"></i>¿Dónde estamos?</div>
                    <div class="card-body p-0">
                        <div class="ratio ratio-4x3">
                            <iframe title="Ubicación - Antojería Tica"
                                    src="https://www.google.com/maps?q=Soda%20Antojer%C3%ADa%20Tica&output=embed"
                                    style="border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                    </div>
                </div>
                <div class="card shadow-sm">
                    <div class="card-header"><i class="bi bi-people me-2"></i>Quiénes somos</div>
                    <div class="card-body">
                        <p class="mb-0 small text-muted">
                            Somos Antojería Tica: sabor casero y auténtico, con opciones para llevar y a domicilio.
                            Preparados cada día para servirte rápido y con calidad.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-info-circle me-2"></i>Información</span>
                        <span class="small"><i class="@iconoEstado me-1"></i>@etiquetaEstado</span>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <div class="text-muted small fw-semibold mb-1">Dirección</div>
                            <div><i class="bi bi-geo-alt me-2"></i>@direccion</div>
                        </div>
                        <div class="mb-3">
                            <div class="text-muted small fw-semibold mb-1">Tipos de servicio</div>
                            <div class="d-flex flex-column gap-2">
                                <div><i class="bi bi-truck me-2"></i>A domicilio <i class="bi bi-check2 ms-1 text-success"></i></div>
                                <div><i class="bi bi-bag me-2"></i>Para llevar <i class="bi bi-check2 ms-1 text-success"></i></div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="text-muted small fw-semibold mb-2">Horarios de atención</div>
                            <div class="list-group list-group-flush">
                                @foreach (var kv in new[]{
                                    (DayOfWeek.Sunday,    "Domingo"),
                                    (DayOfWeek.Monday,    "Lunes"),
                                    (DayOfWeek.Tuesday,   "Martes"),
                                    (DayOfWeek.Wednesday, "Miércoles"),
                                    (DayOfWeek.Thursday,  "Jueves"),
                                    (DayOfWeek.Friday,    "Viernes"),
                                    (DayOfWeek.Saturday,  "Sábado")})
                                {
                                    var (abre, cierra) = horarios[kv.Item1];
                                    var esHoy = hoy.DayOfWeek == kv.Item1;
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span class="@(esHoy ? "fw-semibold" : "")">@kv.Item2</span>
                                        <span class="small text-muted">
                                            @if (abre.HasValue && cierra.HasValue)
                                            {
                                                @($"{new DateTime(hoy.Year,hoy.Month,hoy.Day,abre.Value.Hours,abre.Value.Minutes,0):h:mm tt} - {new DateTime(hoy.Year,hoy.Month,hoy.Day,cierra.Value.Hours,cierra.Value.Minutes,0):h:mm tt}")
                                            }
                                            else
                                            {
                                                <text>Cerrado</text>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="d-grid gap-2 mt-3">
                            <a class="btn btn-brand" asp-controller="Pedidos" asp-action="RegistrarPedido">
                                <i class="bi bi-plus-circle me-1"></i> Hacer pedido
                            </a>
                            <a class="btn btn-outline-danger" asp-controller="Pedidos" asp-action="Seguimiento">
                                <i class="bi bi-bell me-1"></i> Ver seguimiento
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header"><i class="bi bi-currency-dollar me-2"></i>Ventas</div>
                    <div class="card-body">
                        <p class="mb-3 text-muted small">Accesos rápidos</p>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary" asp-controller="Ventas" asp-action="ReporteVentasDia">
                                <i class="bi bi-graph-up"></i> Reporte del día
                            </a>
                            <a class="btn btn-brand" asp-controller="Ventas" asp-action="RegistrarVenta">
                                <i class="bi bi-cash"></i> Nueva venta
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header"><i class="bi bi-receipt me-2"></i>Pedidos</div>
                    <div class="card-body">
                        <p class="mb-3 text-muted small">Gestión de pedidos</p>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary" asp-controller="Pedidos" asp-action="Index">
                                <i class="bi bi-list-check"></i> Ver pedidos
                            </a>
                            <a class="btn btn-outline-danger" asp-controller="Pedidos" asp-action="Cocina">
                                <i class="bi bi-egg-fried"></i> Vista cocina
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header"><i class="bi bi-calculator me-2"></i>Finanzas</div>
                    <div class="card-body">
                        <p class="mb-3 text-muted small">Caja e indicadores</p>
                        <div class="d-grid gap-2">
                            <a class="btn btn-primary" asp-controller="CierreCaja" asp-action="Index">
                                <i class="bi bi-safe2"></i> Cierre de caja
                            </a>
                            <a class="btn btn-outline-danger" asp-controller="Reporte" asp-action="Dashboard">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <style>
        .map-embed iframe { width:100%; height:100%; display:block; }
    </style>
}
